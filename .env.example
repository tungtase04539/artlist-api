# ─── Copy thành `.env` và điền (không commit `.env`) ───

PORT=3000

# BẮT BUỘC: token admin bảo vệ /admin/* và /dashboard. Sinh: openssl rand -hex 32
ADMIN_TOKEN=

# SQLite file (clients, keys, credits, jobs, usage, alerts).
DB_PATH=data/artlist-api.db

# ─── Nguyên liệu artlist (admin cung cấp). Có thể cập nhật lúc chạy qua POST /admin/session ───
ARTLIST_BASE_URL=https://toolkit.artlist.io
# Cookie lấy nguyên từ trình duyệt (cf_clearance/__cf_bm hết hạn nhanh ~30-60').
ARTLIST_COOKIE=
# ⚠️ User-Agent PHẢI khớp trình duyệt đã tạo cf_clearance.
ARTLIST_USER_AGENT=

# ─── Poll & concurrency (outbound) ───
POLL_INTERVAL_MS=4000
POLL_TIMEOUT_MS=600000
MAX_CONCURRENT_JOBS=4

# ─── Rate limit mặc định cho client mới (admin chỉnh riêng từng client được) ───
DEFAULT_RATE_PER_MIN=6
DEFAULT_RATE_PER_DAY=200

# ─── Cache catalog (ms) ───
CATALOG_TTL_MS=300000

# ─── Ngưỡng phát hiện lạm dụng ───
ABUSE_ERROR_RATE=0.5
ABUSE_MIN_EVENTS=20
ABUSE_MULTI_IP=4
