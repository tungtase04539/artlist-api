# ─── Copy this file to `.env` and fill in real values (never commit `.env`) ───

# Cổng server API của bạn
PORT=3000

# API key bảo vệ API CỦA BẠN — client phải gửi header `X-API-Key: <giá trị này>`
# Sinh chuỗi ngẫu nhiên, ví dụ: openssl rand -hex 32
API_KEY=

# ─── Cấu hình phía Artlist (điền sau khi bắt request ở Phase 1) ───

# Base URL của API artlist (ví dụ https://api.artlist.io) — xác định từ cURL đã bắt
ARTLIST_BASE_URL=

# Cookie đăng nhập lấy từ trình duyệt (KHÔNG commit). Dạng: "name=value; name2=value2"
ARTLIST_COOKIE=

# (Tuỳ chọn) Nếu artlist dùng bearer token trong header Authorization
ARTLIST_AUTH_TOKEN=

# (Tuỳ chọn) Nếu có CSRF token cần gửi kèm
ARTLIST_CSRF_TOKEN=

# ─── Cấu hình polling ───
# Khoảng thời gian giữa các lần poll trạng thái (ms) và timeout tổng (ms)
POLL_INTERVAL_MS=4000
POLL_TIMEOUT_MS=600000
# Số job được xử lý đồng thời (tránh bị rate-limit/ban)
MAX_CONCURRENT_JOBS=2
