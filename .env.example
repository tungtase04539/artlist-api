# ─── Copy this file to `.env` and fill in real values (never commit `.env`) ───

# Cổng server API của bạn
PORT=3000

# API key bảo vệ API CỦA BẠN — client phải gửi header `X-API-Key: <giá trị này>`
# Sinh chuỗi ngẫu nhiên, ví dụ: openssl rand -hex 32
API_KEY=

# ─── Cấu hình phía Artlist (điền sau khi bắt request ở Phase 1) ───

# Base URL của API artlist. Với Seedance/toolkit: https://toolkit.artlist.io
ARTLIST_BASE_URL=https://toolkit.artlist.io

# Cookie lấy NGUYÊN từ trình duyệt (KHÔNG commit). Dạng: "name=value; name2=value2"
#  - Auth chính: __Secure-session.artlist-prod.session-token
#  - Cloudflare (HẾT HẠN NHANH ~30-60': cf_clearance, __cf_bm
ARTLIST_COOKIE=

# ⚠️ User-Agent PHẢI KHỚP CHÍNH XÁC trình duyệt đã tạo cf_clearance, nếu không Cloudflare chặn.
# Copy nguyên chuỗi UA từ request thật (tab Headers → Request Headers → user-agent).
ARTLIST_USER_AGENT=

# (Auth qua cookie là chính; hai field dưới thường KHÔNG cần cho artlist.)
ARTLIST_AUTH_TOKEN=
ARTLIST_CSRF_TOKEN=

# ─── Cấu hình polling ───
# Khoảng thời gian giữa các lần poll trạng thái (ms) và timeout tổng (ms)
POLL_INTERVAL_MS=4000
POLL_TIMEOUT_MS=600000
# Số job được xử lý đồng thời (tránh bị rate-limit/ban)
MAX_CONCURRENT_JOBS=2
