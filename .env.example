# ─── Copy thành `.env` và điền (không commit `.env`) ───

PORT=3000

# BẮT BUỘC: token admin bảo vệ /admin/* và /dashboard. Sinh: openssl rand -hex 32
ADMIN_TOKEN=

# DB: Postgres/Supabase (prod). VD Supabase (dùng connection pooler port 6543):
#   postgres://postgres.<ref>:<pass>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Để TRỐNG => PGlite in-process (local/dev, lưu ở PGLITE_DIR hoặc in-memory).
DATABASE_URL=
PGLITE_DIR=
# Bảo vệ /cron/sweep (Vercel Cron gửi `Authorization: Bearer <CRON_SECRET>`).
CRON_SECRET=

# ─── Nguyên liệu artlist (admin cung cấp). Có thể cập nhật lúc chạy qua POST /admin/session ───
ARTLIST_BASE_URL=https://toolkit.artlist.io
# Cookie lấy nguyên từ trình duyệt (cf_clearance/__cf_bm hết hạn nhanh ~30-60').
ARTLIST_COOKIE=
# ⚠️ User-Agent PHẢI khớp trình duyệt đã tạo cf_clearance.
ARTLIST_USER_AGENT=

# ─── Poll & concurrency (outbound) ───
POLL_INTERVAL_MS=4000
POLL_TIMEOUT_MS=600000
MAX_CONCURRENT_JOBS=4

# ─── Suno (tạo nhạc) qua nhà cung cấp AI33 — reseller. Trống AI33_API_KEY => tắt /v1/music ───
AI33_BASE_URL=https://api.ai33.pro
AI33_API_KEY=                    # key nguồn từ ai33.pro (bí mật, KHÔNG commit)
SUNO_PRICE_CREDITS=3600           # giá bán 1 lần tạo nhạc (credits) — admin tự chỉnh
SUNO_POLL_TIMEOUT_MS=600000

# ─── Rate limit mặc định cho client mới (admin chỉnh riêng từng client được) ───
DEFAULT_RATE_PER_MIN=6
DEFAULT_RATE_PER_DAY=200

# ─── Cache catalog (ms) ───
CATALOG_TTL_MS=300000

# ─── Ngưỡng phát hiện lạm dụng ───
ABUSE_ERROR_RATE=0.5
ABUSE_MIN_EVENTS=20
ABUSE_MULTI_IP=4
ABUSE_AUTO_SUSPEND=true         # tự khoá client khi cố cheat giá
MAX_CONCURRENT_PER_CLIENT=3     # job đang chạy tối đa/client
MAX_IMAGE_MB=10                 # trần ảnh upload (image-to-video)

# ─── Cảnh báo đẩy (khi session hết hạn cần dán cookie mới, hoặc bị cheat) ───
# Telegram: nhắn @BotFather /newbot lấy token; lấy chat_id qua @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Hoặc webhook Discord/Slack (điền URL webhook). Có thể dùng cả hai.
ALERT_WEBHOOK_URL=
DASHBOARD_URL=https://artlist-api.vercel.app/dashboard   # chèn link vào cảnh báo
# Loại cảnh báo sẽ đẩy (mặc định đủ dùng):
ALERT_PUSH_KINDS=session_expired,auto_suspend,price_mismatch
